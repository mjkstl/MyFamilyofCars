# Copy this file to .env and fill in values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
#
# EXPO_PUBLIC_ prefix means these are safe to ship in the client bundle:
# the anon key is designed to be public and is constrained by Row Level
# Security policies (see supabase/migrations/0001_init.sql).
# NEVER put the service_role key or ANTHROPIC_API_KEY here — those live
# only as Supabase Edge Function secrets (see SETUP.md).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
